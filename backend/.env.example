# JALDRISHTI Backend Environment Configuration

ENVIRONMENT=development
PROJECT_NAME="JALDRISHTI"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/jaldrishti"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/jaldrishti"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://localhost:3000"]

# Municipal GIS & Domain Configuration
MUNICIPALITY_NAME="Barasat Municipality"
MUNICIPALITY_CODE="BARASAT_WB"
DEFAULT_LATITUDE=22.7214
DEFAULT_LONGITUDE=88.4821
CRS_DEFAULT="EPSG:4326"
CRS_PROJECTED="EPSG:32645"

# Operational Mode
DEFAULT_OPERATION_MODE="LIVE"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="JSON"
